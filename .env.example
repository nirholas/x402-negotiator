# ---------------------------------------------------------------------------
# Payment rails — every paid route accepts USDC on BOTH rails; the client picks.
# These are the x402 Suite's public receive addresses. Replace them with your
# own to be the one who gets paid.
# ---------------------------------------------------------------------------

# EVM (Base / Base Sepolia) USDC receive address
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# Solana USDC receive address
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# ----- EVM rail -----
# base-sepolia (testnet, default) or base (mainnet).
NETWORK=base-sepolia
# x402 facilitator for the EVM rail. The default settles base-sepolia.
# FACILITATOR_URL=https://x402.org/facilitator

# ----- Solana rail -----
# mainnet-beta (default) or devnet.
SOLANA_NETWORK=mainnet-beta
# Facilitator that verifies + settles the Solana rail. The default is PayAI's
# public facilitator, which settles both solana and solana-devnet, no key needed.
# SOLANA_FACILITATOR_URL=https://facilitator.payai.network
# Facilitator sponsor account that pays the SOL network fee so buyers need only
# USDC. Defaults to the facilitator's advertised feePayer.
# SOLANA_FEE_PAYER=

# ----- service config -----
# Port to listen on.
PORT=4045
# HMAC secret for signing instruments. REQUIRED in production — a built-in dev
# secret is used (with a console warning) when unset.
#
# Every instrument this server has ever issued is signed with it, so rotating it
# invalidates instruments already in counterparties hands. Set it once, before
# the first negotiation.
SIGNING_SECRET=
# Absolute base URL used in the counter/accept links handed to counterparties
# (defaults to the request host).
# PUBLIC_BASE_URL=https://negotiate.example.com

# This service is self-contained — no third-party data APIs, no keys to obtain.
# Thread state persists to data/threads.json (file-based, gitignored). Losing it
# does not invalidate anything: instruments carry their own chain and remain
# verifiable via POST /verify-chain.

# ----- examples/agent-client.ts only -----
# Wallet that PAYS (holds Base Sepolia USDC — faucet: https://faucet.circle.com).
# PRIVATE_KEY=0x...
# BASE_URL=http://localhost:4045
